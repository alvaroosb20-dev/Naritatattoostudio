# ─── Copia estas variables en Vercel → Project → Settings → Environment Variables ───
# NUNCA subas los valores reales a GitHub.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Panel /admin
ADMIN_PASSWORD=
# Cadena larga y aleatoria (mínimo 32 caracteres). Sirve para firmar la sesión del panel.
ADMIN_SESSION_SECRET=

# Aviso por correo de cada solicitud nueva (opcional, con resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Remitente de un dominio verificado en Resend, ej.: Narita Tattoo <reservas@tudominio.com>
NOTIFY_EMAIL_FROM=

# Dominio final (opcional; si no, se usa el de la petición)
SITE_URL=
